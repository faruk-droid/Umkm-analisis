# Nama aplikasi kerja (dapat diganti melalui UI Settings atau file ini)
NEXT_PUBLIC_APP_NAME="SMART-BIZ"

# AI provider (server-side only). Gemini recommended; visitors do not need an account.
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_PROVIDER="gemini"

# Supabase (Opsional - Jika belum diisi, aplikasi berjalan 100% menggunakan Local / In-Memory Demo Storage)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Mode Pengujian / Demo
NEXT_PUBLIC_DEMO_MODE="true"
